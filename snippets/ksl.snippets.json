{
	"Library Declaration": {
		"prefix": "using",
		"body": "using std.${1|io,fs,env,math,random,time|};",
		"description": "Include a library"
	},
	"Function Declaration": {
		"prefix": "fn",
		"body": [
			"fn ${1}(${2}) -> ${3} {",
			"    ${4}",
			"}"
		],
		"description": "New function declaration"
	},
	"If Statement": {
		"prefix": "if",
		"body": [
			"if (${1}) {",
			"    ${2}",
			"}"
		],
		"description": "New if statement"
	},
	"For Loop": {
		"prefix": "for",
		"body": [
			"for (int ${1} = ${2}; ${3}; ${4}) {",
			"    ${5}",
			"}"
		],
		"description": "New for loop"
	},
	"While Loop": {
		"prefix": "while",
		"body": [
			"while (${1}) {",
			"    ${2}",
			"}"
		],
		"description": "New while loop"
	}
}
